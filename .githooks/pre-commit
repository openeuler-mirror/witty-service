#!/bin/bash
set -e

if ! command -v pre-commit >/dev/null 2>&1; then
    echo "pre-commit not found. Install it first: uv tool install pre-commit" >&2
    exit 1
fi

# 仅检查暂存区变更文件（全量检查：pre-commit run --all-files）
cd "$(git rev-parse --show-toplevel)"
exec pre-commit run --config .pre-commit-config.yaml
